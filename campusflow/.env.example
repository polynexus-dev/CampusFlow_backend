# ==============================================================================
# CampusNexus Backend Configuration Template
# ==============================================================================

# SMTP E-Mail configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@campusnexus.in
EMAIL_HOST_PASSWORD=your_secure_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CampusNexus <noreply@campusnexus.in>

# Redis configuration (if any, falls back to LocMem/LocMemCache if empty)
REDIS_URL=redis://localhost:6379/0

# Brevo API Key fallback (alternative to SMTP)
BREVO_API_KEY=
