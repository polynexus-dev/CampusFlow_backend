# ==============================================================================
# CampusNexus Backend Configuration Template
# ==============================================================================

# Core Application Settings
DEBUG=True
SECRET_KEY=
FIELD_ENCRYPTION_KEY=

# SaaS superuser created on first boot (public schema). Leave empty to skip.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Boot options (entrypoint.sh). Both default to off.
# SEED_DEMO_DATA=1     -> create/seed the public 'demo' college (sales demo server only)
# RUN_MIGRATION_SYNC=1 -> run migrate_sync.py once to recover a drifted dev database
SEED_DEMO_DATA=0
RUN_MIGRATION_SYNC=0

# Rate limits for login / one-time codes (DRF rate strings) and proxy depth
# used to find the client IP (1 = one nginx in front of the app).
# THROTTLE_LOGIN=10/min
# THROTTLE_OTP=5/min
# THROTTLE_OTP_VERIFY=10/min
# DRF_NUM_PROXIES=1

# SMTP E-Mail configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@campusnexus.in
EMAIL_HOST_PASSWORD=your_secure_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CampusNexus <noreply@campusnexus.in>

# WhatsApp OTP (AWS End User Messaging Social). Leave WA_ORIGINATION_ID empty
# to send OTPs by email only. phoneNumberId from:
#   aws socialmessaging get-linked-whatsapp-business-account --id <waba-id> --region ap-south-1
WA_ORIGINATION_ID=
# Defaults: ap-south-1 / otp_login / en. WA_OTP_LANGUAGE must match the
# template's language exactly ("en" vs "en_IN"), or Meta rejects the send.
WA_AWS_REGION=
WA_OTP_TEMPLATE=
WA_OTP_LANGUAGE=
# Only needed when running outside AWS; on AWS leave both empty and use an IAM
# role. Required IAM permission: social-messaging:SendWhatsAppMessage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Polynexus bank account shown on colleges' Subscription Billing page (NEFT/RTGS).
# Leave account number / IFSC empty to hide bank details entirely.
POLYNEXUS_BANK_NAME=
POLYNEXUS_BANK_ACCOUNT_NAME=Polynexus Technologies Private Limited
POLYNEXUS_BANK_ACCOUNT_NUMBER=
POLYNEXUS_BANK_IFSC=
POLYNEXUS_BANK_BRANCH=

# Redis configuration (if any, falls back to LocMem/LocMemCache if empty)
REDIS_URL=redis://localhost:6379/0

# Brevo API Key fallback (alternative to SMTP)
BREVO_API_KEY=

# Error tracking (optional) — leave SENTRY_DSN empty to disable entirely
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# On-premise AI (Ollama) — every AI-assisted feature (answer-sheet valuation,
# accreditation narrative drafting, question generation, student insight)
# runs against a locally-hosted model, never a third-party AI API. Under
# docker-compose this is provisioned automatically (see the `ollama` service
# in docker-compose.yml) and these are left blank to use its defaults; only
# set them here if running Django directly against your own Ollama instance.
# OLLAMA_HOST_PORT=11434  # Optional host port mapping for Docker Compose (change if host 11434 is in use)
OLLAMA_BASE_URL=
AI_GRADING_MODEL=
AI_NARRATIVE_MODEL=
